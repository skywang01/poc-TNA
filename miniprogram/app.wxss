/* Global styles — BIPO palette (amber + indigo) */
page {
  --indigo: #4f46e5;
  --violet: #7c3aed;
  --amber: #fbbf24;
  --ink: #1e293b;
  --slate: #64748b;
  --mute: #94a3b8;
  --line: #e9edf3;
  --bg: #eef0f4;
  --red: #dc2626;
  --green: #16a34a;
  background: #eef0f4;
  font-family: -apple-system, "PingFang SC", "Microsoft YaHei", sans-serif;
  color: #1e293b;
}

.card {
  background: #fff;
  border: 1rpx solid #e9edf3;
  border-radius: 28rpx;
  padding: 28rpx;
  margin-bottom: 24rpx;
}
.card-title {
  font-size: 28rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  margin-bottom: 24rpx;
}
.card-title .ic {
  width: 44rpx; height: 44rpx; border-radius: 12rpx;
  display: flex; align-items: center; justify-content: center;
  margin-right: 14rpx; font-size: 24rpx;
}
.ic-warn { background: #fef2f2; }
.ic-law { background: #fffbeb; }
.ic-chart { background: #eef2ff; }
.count { margin-left: auto; font-size: 22rpx; color: #94a3b8; font-weight: 400; }

.btn {
  border: none; font-size: 26rpx; padding: 16rpx 26rpx;
  border-radius: 18rpx; font-weight: 600; line-height: 1;
}
.btn-primary { background: #4f46e5; color: #fff; }
.btn-ghost { background: #fff; color: #4f46e5; border: 1rpx solid #c7d2fe; }
button::after { border: none; }

/* alerts (anomaly / compliance) */
.alert { display: flex; gap: 20rpx; padding: 22rpx; border-radius: 20rpx; margin-bottom: 16rpx; }
.alert-red { background: #fef2f2; border: 1rpx solid #fecaca; }
.alert-amber { background: #fffbeb; border: 1rpx solid #fde68a; }
.alert .dot { width: 16rpx; height: 16rpx; border-radius: 50%; margin-top: 10rpx; flex-shrink: 0; }
.dot-red { background: #ef4444; }
.dot-amber { background: #f59e0b; }
.alert .c { flex: 1; font-size: 26rpx; }
.alert .c .t { font-weight: 600; margin-bottom: 6rpx; }
.alert .c .why { color: #64748b; font-size: 23rpx; line-height: 1.5; }
.alert .c .why .ai { color: #7c3aed; font-weight: 600; }
.sev { font-size: 20rpx; padding: 4rpx 14rpx; border-radius: 10rpx; font-weight: 700; height: fit-content; }
.sev-high { background: #fee2e2; color: #b91c1c; }
.sev-mid { background: #fef3c7; color: #b45309; }
