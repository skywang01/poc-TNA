/* ============================================================
   BIPO Attendance AI — global styles (REDESIGN)
   Palette: BIPO navy (#20307D) + intelligence blue (#2A63E6).
   Drop-in replacement for app.wxss — WXML/JS unchanged.
   ============================================================ */
page {
  /* brand */
  --navy: #20307D;
  --navy-900: #131C4D;
  --blue: #2A63E6;          /* interactive + AI accent (was violet) */
  --blue-tint: #EDF1FE;
  --blue-tint-bd: #D6DEFB;
  --royal-200: #BFC8EC;     /* hairline on light chips/outlines */
  /* neutrals (cool slate) */
  --ink: #0E1629;
  --slate: #4E5A72;
  --mute: #8C95A8;
  --line: #E0E4EC;
  --divider: #EEF1F6;
  --bg: #F5F7FB;
  --sunken: #F0F2F7;
  /* semantic */
  --red: #DC2626;       --red-surface: #FDF1F1;   --red-bd: #F6CFCF;
  --amber: #D9810A;     --amber-surface: #FEF6E8; --amber-bd: #F6DFAE;
  --green: #1A9D4D;     --green-surface: #E9F7EF;

  background: #F5F7FB;
  font-family: -apple-system, "PingFang SC", "Microsoft YaHei", sans-serif;
  color: var(--ink);
}

.card {
  background: #fff;
  border: 1rpx solid var(--line);
  border-radius: 32rpx;
  padding: 28rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 1rpx 3rpx rgba(20,28,46,.06), 0 1rpx 2rpx rgba(20,28,46,.04);
}
.card-title {
  font-size: 30rpx;
  font-weight: 600;
  letter-spacing: -0.3rpx;
  color: var(--ink);
  display: flex;
  align-items: center;
  margin-bottom: 24rpx;
}
.card-title .ic {
  width: 44rpx; height: 44rpx; border-radius: 12rpx;
  display: flex; align-items: center; justify-content: center;
  margin-right: 14rpx; font-size: 24rpx;
}
.ic-warn { background: var(--red-surface); }
.ic-law { background: var(--amber-surface); }
.ic-chart { background: var(--blue-tint); }
.count { margin-left: auto; font-size: 22rpx; color: var(--mute); font-weight: 400; }

.btn {
  border: none; font-size: 26rpx; padding: 16rpx 26rpx;
  border-radius: 18rpx; font-weight: 600; line-height: 1;
}
.btn-primary { background: var(--navy); color: #fff; }
.btn-ghost { background: #fff; color: var(--navy); border: 1rpx solid var(--royal-200); }
button::after { border: none; }

/* alerts (anomaly / compliance) */
.alert { display: flex; gap: 20rpx; padding: 22rpx; border-radius: 20rpx; margin-bottom: 16rpx; }
.alert-red { background: var(--red-surface); border: 1rpx solid var(--red-bd); }
.alert-amber { background: var(--amber-surface); border: 1rpx solid var(--amber-bd); }
.alert .dot { width: 16rpx; height: 16rpx; border-radius: 50%; margin-top: 10rpx; flex-shrink: 0; }
.dot-red { background: #EF4444; }
.dot-amber { background: var(--amber); }
.alert .c { flex: 1; font-size: 26rpx; }
.alert .c .t { font-weight: 600; margin-bottom: 6rpx; color: var(--ink); }
.alert .c .why { color: var(--slate); font-size: 23rpx; line-height: 1.5; }
.alert .c .why .ai { color: var(--blue); font-weight: 600; }   /* AI attribution — now blue */
.sev { font-size: 20rpx; padding: 4rpx 14rpx; border-radius: 999rpx; font-weight: 700; height: fit-content; }
.sev-high { background: var(--red-surface); color: #C32B2B; }
.sev-mid { background: #FBEFD5; color: #B45309; }
