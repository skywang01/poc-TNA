<view class="chat">
  <scroll-view class="stream" scroll-y scroll-into-view="{{toView}}" scroll-with-animation>
    <view wx:for="{{messages}}" wx:key="id" id="m{{item.id}}" class="row {{item.role === 'user' ? 'me' : 'ai'}}">

      <!-- user bubble -->
      <block wx:if="{{item.role === 'user'}}">
        <view class="bubble me-bubble">{{item.text}}</view>
        <view class="av av-u">🙂</view>
      </block>

      <!-- agent message -->
      <block wx:else>
        <view class="av av-ai">✨</view>
        <view class="bubble ai-bubble">

          <!-- text -->
          <view wx:if="{{item.ctype === 'text'}}" class="txt">{{item.text}}</view>

          <!-- tool_call -->
          <view wx:elif="{{item.ctype === 'toolcall'}}" class="toolcall">🔧 调用 {{item.label}}</view>

          <!-- analysis_progress -->
          <view wx:elif="{{item.ctype === 'progress'}}" class="progress">
            <view>🔎 {{item.label}}</view>
            <view class="pbar"><view class="pbar-i"></view></view>
            <view class="pstep">已扫描 {{item.scanned}} / {{item.total}} · 完成</view>
          </view>

          <!-- ot_breakdown -->
          <view wx:elif="{{item.ctype === 'ot_breakdown'}}" class="a2ui">
            <view class="a2-h">📊 {{item.title}}<text class="a2-badge">A2UI · ot_breakdown</text></view>
            <view class="a2-b">
              <block wx:for="{{item.people}}" wx:for-item="p" wx:for-index="pi" wx:key="name">
                <view class="hbar {{item.open === p.name ? 'hbar-open' : ''}}" data-i="{{index}}" data-name="{{p.name}}" bindtap="toggleDrill">
                  <view class="hnm">{{p.name}}</view>
                  <view class="htk"><view class="htk-i" style="width: {{p.pct}}%"></view></view>
                  <view class="hvv">{{p.hours}}h</view>
                </view>
                <view wx:if="{{item.open === p.name}}" class="drill">
                  <view wx:for="{{p.daily}}" wx:for-item="d" wx:key="date" class="drow">
                    <text>{{d.date}}</text><text class="dh">{{d.hours}}h</text>
                  </view>
                </view>
              </block>
              <view class="drill-hint">↳ 点任意一行下钻到逐日打卡明细</view>
            </view>
          </view>

          <!-- ot_approval -->
          <view wx:elif="{{item.ctype === 'ot_approval'}}" class="a2ui">
            <view class="a2-h">📝 OT 审批 · {{item.pending.name}}<text class="a2-badge">A2UI · ot_approval</text></view>
            <view class="a2-b">
              <view class="aline"><text class="al-k">部门</text><text>{{item.pending.dept}}</text></view>
              <view class="aline"><text class="al-k">日期</text><text>{{item.pending.date}}</text></view>
              <view class="aline"><text class="al-k">时长</text><text class="b">{{item.pending.hours}} 小时</text></view>
              <view class="aline"><text class="al-k">事由</text><text>{{item.pending.reason}}</text></view>
              <view wx:if="{{item.pending.flag}}" class="aflag">⚠️ AI 提醒:{{item.pending.flag}}</view>
              <view wx:if="{{!item.pending.status}}" class="abtns">
                <button class="bb ok" size="mini" data-i="{{index}}" bindtap="approve">✓ 批准</button>
                <button class="bb no" size="mini" data-i="{{index}}" bindtap="reject">驳回</button>
              </view>
              <view wx:else class="adone {{item.pending.status === 'approved' ? 'adone-ok' : 'adone-no'}}">
                {{item.pending.status === 'approved' ? '✓ 已批准' : '已驳回'}}
              </view>
            </view>
          </view>

          <!-- anomaly_alert -->
          <view wx:elif="{{item.ctype === 'anomaly_alert'}}" class="a2ui">
            <view class="a2-h">⚠️ AI 异常检测<text class="a2-badge">A2UI · anomaly_alert</text></view>
            <view class="a2-b">
              <view wx:for="{{item.items}}" wx:for-item="a" wx:key="id" class="alert {{a.severity === 'high' ? 'alert-red' : 'alert-amber'}}">
                <view class="dot {{a.severity === 'high' ? 'dot-red' : 'dot-amber'}}"></view>
                <view class="c"><view class="t">{{a.title}}</view><view class="why">{{a.why}}<text class="ai">{{a.ai}}</text></view></view>
                <view class="sev {{a.severity === 'high' ? 'sev-high' : 'sev-mid'}}">{{a.severity === 'high' ? '高' : '中'}}</view>
              </view>
            </view>
          </view>

          <!-- proactive -->
          <view wx:elif="{{item.ctype === 'proactive'}}" class="proact">
            <view class="ptext">💡 {{item.text}}</view>
            <view class="chips">
              <view wx:for="{{item.chips}}" wx:for-item="c" wx:for-index="ci" wx:key="label"
                    class="chip {{c.solid ? 'chip-solid' : ''}} {{item.done ? 'chip-off' : ''}}"
                    data-i="{{index}}" data-action="{{c.action}}" bindtap="chipTap">{{c.label}}</view>
            </view>
          </view>

          <!-- generated_dashboard -->
          <view wx:elif="{{item.ctype === 'generated_dashboard'}}" class="a2ui">
            <view class="a2-h">🧩 {{item.title}}(AI 生成)<text class="a2-badge">A2UI · generated_dashboard</text></view>
            <view class="a2-b">
              <view class="gtiles">
                <view wx:for="{{item.tiles}}" wx:for-item="t" wx:key="label" class="gtile">
                  <view class="gl">{{t.label}}</view>
                  <view class="gv {{t.danger ? 'danger' : ''}}">{{t.value}}</view>
                </view>
              </view>
              <view class="mini-bars">
                <view wx:for="{{item.series}}" wx:for-item="v" wx:key="*this" class="mb" style="height: {{v}}%"></view>
              </view>
              <button class="pinbtn" size="mini" disabled="{{item.pinned}}" data-i="{{index}}" bindtap="pin">
                {{item.pinned ? '✓ 已钉到首页' : '📌 钉到首页看板'}}
              </button>
            </view>
          </view>

        </view>
      </block>
    </view>

    <!-- typing -->
    <view wx:if="{{streaming}}" class="row ai">
      <view class="av av-ai">✨</view>
      <view class="typing"><view class="td"></view><view class="td"></view><view class="td"></view></view>
    </view>
    <view id="mbottom" style="height: 20rpx"></view>
  </scroll-view>

  <!-- composer -->
  <view class="composer">
    <scroll-view class="sug" scroll-x>
      <view wx:for="{{suggestions}}" wx:key="*this" class="q" data-q="{{item}}" bindtap="onSuggest">{{item}}</view>
    </scroll-view>
    <view class="box">
      <input class="inp" value="{{input}}" placeholder="问问考勤的任何问题…" confirm-type="send"
             bindinput="onInput" bindconfirm="onSendTap" />
      <button class="send" size="mini" disabled="{{streaming || !input}}" bindtap="onSendTap">↑</button>
    </view>
  </view>
</view>
