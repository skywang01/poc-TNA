<view class="chat">
  <!-- in-page header: brand + lang toggle + tap-to-set avatar -->
  <view class="mini-head">
    <view class="mh-left">
      <view class="mh-ava"><image class="mh-ava-img" src="/assets/icons/sparkles-white.svg" /></view>
      <view class="mh-meta">
        <view class="mh-title">{{t.chatTitle}}</view>
        <view class="mh-sub">{{t.chatSub}}</view>
      </view>
    </view>
    <view class="mh-right">
      <view class="mh-role" hover-class="mh-clear-hd" bindtap="switchRole">⇄ {{roleLabel}}</view>
      <view class="mh-clear" hover-class="mh-clear-hd" bindtap="clearSession">{{t.clearChat}}</view>
      <button class="me-ava-btn" open-type="chooseAvatar" bindchooseavatar="onChooseAvatar">
        <image wx:if="{{userAvatar}}" class="me-ava-img" src="{{userAvatar}}" mode="aspectFill" />
        <view wx:else class="me-ava-ph"></view>
      </button>
    </view>
  </view>

  <scroll-view class="stream" scroll-y scroll-into-view="{{toView}}" scroll-with-animation>
    <view wx:for="{{messages}}" wx:key="id" id="m{{item.id}}" class="row {{item.role === 'user' ? 'me' : 'ai'}}">

      <block wx:if="{{item.role === 'user'}}">
        <view class="bubble me-bubble">{{item.text}}</view>
        <image wx:if="{{userAvatar}}" class="av" src="{{userAvatar}}" mode="aspectFill" />
        <view wx:else class="av av-u"></view>
      </block>

      <block wx:else>
        <view class="av av-ai"><image class="av-ai-img" src="/assets/icons/sparkles-white.svg" /></view>
        <view class="bubble ai-bubble">

          <view wx:if="{{item.ctype === 'text'}}" class="txt">{{item.text}}</view>

          <view wx:elif="{{item.ctype === 'toolcall'}}" class="toolcall">
            <view class="tc-main"><image class="tc-img" src="/assets/icons/wrench-blue.svg" />{{item.label}}</view>
            <view wx:if="{{item.raw}}" class="tc-raw">{{item.raw}}</view>
          </view>

          <view wx:elif="{{item.ctype === 'progress'}}" class="progress">
            <view class="prog-head"><image class="prog-img" src="/assets/icons/search-blue.svg" />{{item.label}}</view>
            <view class="pbar"><view class="pbar-i"></view></view>
            <view class="pstep">{{t.scanned}} {{item.scanned}} / {{item.total}} · {{t.done}}</view>
          </view>

          <!-- attendance_report:声明式 views,按 chart 类型查注册表渲染 -->
          <view wx:elif="{{item.ctype === 'attendance_report'}}" class="a2ui">
            <view class="a2-h"><image class="a2-img" src="/assets/icons/chart-blue.svg" />{{item.title}}<text class="a2-badge">A2UI · attendance_report</text></view>
            <view class="a2-b">
              <chart-view wx:for="{{item.views}}" wx:for-item="v" wx:key="title" view="{{v}}" />
            </view>
          </view>

          <!-- ot_breakdown -->
          <view wx:elif="{{item.ctype === 'ot_breakdown'}}" class="a2ui">
            <view class="a2-h"><image class="a2-img" src="/assets/icons/chart-blue.svg" />{{item.title}}<text class="a2-badge">A2UI · ot_breakdown</text></view>
            <view class="a2-b">
              <block wx:for="{{item.people}}" wx:for-item="p" wx:for-index="pi" wx:key="name">
                <view class="hbar {{item.open === p.name ? 'hbar-open' : ''}}" data-i="{{index}}" data-name="{{p.name}}" bindtap="toggleDrill">
                  <view class="hnm">{{p.name}}</view>
                  <view class="htk"><view class="htk-i" style="width: {{p.pct}}%"></view></view>
                  <view class="hvv">{{p.hours}}h</view>
                </view>
                <view wx:if="{{item.open === p.name}}" class="drill">
                  <view wx:for="{{p.daily}}" wx:for-item="d" wx:key="date" class="drow">
                    <text>{{d.date}}</text><text class="dh">{{d.hours}}h</text>
                  </view>
                </view>
              </block>
              <view class="drill-hint">{{t.drillHint}}</view>
            </view>
          </view>

          <!-- clock_punch:打卡确认卡(时间/地点/人),确认后才调工具 -->
          <view wx:elif="{{item.ctype === 'clock_punch'}}" class="a2ui">
            <view class="a2-h"><image class="a2-img" src="/assets/icons/filetext-blue.svg" />{{item.punchType === 'in' ? t.punchInTitle : t.punchOutTitle}}<text class="a2-badge">A2UI · clock_punch</text></view>
            <view class="a2-b">
              <!-- hero:类型 + 准点徽章 + 大时间(含秒) + 长日期·班次 -->
              <view class="punch-hero">
                <view class="ph-top">
                  <view class="ph-type"><text class="ph-dot"></text>{{item.punchType === 'in' ? t.punchTypeIn : t.punchTypeOut}}</view>
                  <view wx:if="{{item.badge}}" class="ph-badge {{item.badgeOk ? '' : 'ph-badge-warn'}}">{{item.badgeOk ? '✓ ' : ''}}{{item.badge}}</view>
                </view>
                <view class="ph-time">{{item.timeHM}}<text class="ph-sec">:{{item.timeSS}}</text></view>
                <view class="ph-date">{{item.dateLong}}{{item.shiftLabel ? ' · ' + item.shiftLabel : ''}}</view>
              </view>
              <!-- 地点卡:办公室名 + 围栏状态副行 -->
              <view class="ploc" data-i="{{index}}" bindtap="punchLoc" hover-class="ploc-hd">
                <view class="ploc-ic"><image class="ploc-img" src="/assets/icons/pin-blue.svg" /></view>
                <view class="ploc-c">
                  <view class="ploc-name">{{item.locText}}</view>
                  <view wx:if="{{item.locSub}}" class="ploc-sub {{item.locState}}">{{item.locSub}}</view>
                </view>
                <text wx:if="{{item.status === 'pending'}}" class="prow-arrow">›</text>
              </view>
              <!-- 动作区:唯一主 CTA + 文字按钮 -->
              <view wx:if="{{item.status === 'pending'}}" class="punch-actions">
                <button class="punch-cta" hover-class="punch-cta-hd" data-i="{{index}}" bindtap="confirmPunch">✓ {{item.punchType === 'in' ? t.punchConfirmIn : t.punchConfirmOut}}</button>
                <button class="punch-ghost" hover-class="punch-ghost-hd" data-i="{{index}}" bindtap="cancelPunch">{{t.punchCancel}}</button>
              </view>
              <view wx:elif="{{item.status === 'done'}}" class="adone adone-ok">{{t.punchDone}}{{item.time}}</view>
              <view wx:else class="adone adone-no">{{t.punchCancelled}}</view>
            </view>
          </view>

          <!-- ot_approval -->
          <view wx:elif="{{item.ctype === 'ot_approval'}}" class="a2ui">
            <view class="a2-h"><image class="a2-img" src="/assets/icons/filetext-blue.svg" />OT · {{item.pending.name}}<text class="a2-badge">A2UI · ot_approval</text></view>
            <view class="a2-b">
              <view class="aline"><text class="al-k">{{t.kDept}}</text><text>{{item.pending.dept}}</text></view>
              <view class="aline"><text class="al-k">{{t.kDate}}</text><text>{{item.pending.date}}</text></view>
              <view wx:if="{{item.pending.start}}" class="aline"><text class="al-k">{{t.kTime}}</text><text>{{item.pending.start}}–{{item.pending.end}}</text></view>
              <view wx:if="{{item.pending.otType}}" class="aline"><text class="al-k">{{t.kOtType}}</text><text>{{item.pending.otType === 'leave' ? 'OT Leave' : 'OT Pay'}}</text></view>
              <view class="aline"><text class="al-k">{{t.kHours}}</text><text class="b">{{item.pending.hours}}{{t.hoursUnit}}</text></view>
              <view class="aline"><text class="al-k">{{t.kReason}}</text><text>{{item.pending.reason}}</text></view>
              <view wx:if="{{item.pending.flag}}" class="aflag"><image class="aflag-img" src="/assets/icons/alert-amber.svg" /><text>{{t.aiNote}}{{item.pending.flag}}</text></view>
              <view wx:if="{{!item.pending.status}}" class="abtns">
                <button class="bb ok" size="mini" data-i="{{index}}" bindtap="approve">{{t.approve}}</button>
                <button class="bb no" size="mini" data-i="{{index}}" bindtap="reject">{{t.reject}}</button>
              </view>
              <view wx:else class="adone {{item.pending.status === 'approved' ? 'adone-ok' : 'adone-no'}}">
                {{item.pending.status === 'approved' ? t.approved : t.rejected}}
              </view>
            </view>
          </view>

          <!-- ot_pending_list:待审批 OT 表格(横向滚动,行内批准/驳回) -->
          <view wx:elif="{{item.ctype === 'ot_pending_list'}}" class="a2ui">
            <view class="a2-h"><image class="a2-img" src="/assets/icons/filetext-blue.svg" />{{t.otPendingTitle}} · {{item.items.length}}<text class="a2-badge">A2UI · ot_pending_list</text></view>
            <view class="a2-b">
              <scroll-view class="otl-scroll" scroll-x>
                <view class="otl-table">
                  <view class="otl-row otl-head">
                    <text class="otl-c otl-name">{{t.kName}}</text>
                    <text class="otl-c otl-date">{{t.kDate}}</text>
                    <text class="otl-c otl-time">{{t.kStart}}</text>
                    <text class="otl-c otl-time">{{t.kEnd}}</text>
                    <text class="otl-c otl-hours">{{t.kHours}}</text>
                    <text class="otl-c otl-type">{{t.kOtType}}</text>
                    <text class="otl-c otl-reason">{{t.kReason}}</text>
                    <text class="otl-c otl-act">{{t.kAction}}</text>
                  </view>
                  <view wx:for="{{item.items}}" wx:for-item="r" wx:for-index="j" wx:key="id" class="otl-row">
                    <text class="otl-c otl-name otl-name-link" data-i="{{index}}" data-j="{{j}}" catchtap="viewOneOt">{{r.flag ? '⚠ ' : ''}}{{r.name}}</text>
                    <text class="otl-c otl-date">{{r.date}}</text>
                    <text class="otl-c otl-time">{{r.start || '—'}}</text>
                    <text class="otl-c otl-time">{{r.end || '—'}}</text>
                    <text class="otl-c otl-hours">{{r.hours}}h</text>
                    <text class="otl-c otl-type">{{r.otType === 'leave' ? 'OT Leave' : 'OT Pay'}}</text>
                    <text class="otl-c otl-reason">{{r.reason}}</text>
                    <view class="otl-c otl-act">
                      <block wx:if="{{!r.status}}">
                        <text class="otl-btn otl-ok" data-i="{{index}}" data-j="{{j}}" catchtap="approveRow">{{t.approve}}</text>
                        <text class="otl-btn otl-no" data-i="{{index}}" data-j="{{j}}" catchtap="rejectRow">{{t.reject}}</text>
                      </block>
                      <text wx:else class="otl-st {{r.status === 'approved' ? 'otl-st-ok' : 'otl-st-no'}}">{{r.status === 'approved' ? t.approved : t.rejected}}</text>
                    </view>
                  </view>
                </view>
              </scroll-view>
              <block wx:for="{{item.items}}" wx:for-item="r" wx:key="id">
                <view wx:if="{{r.flag}}" class="aflag"><image class="aflag-img" src="/assets/icons/alert-amber.svg" /><text>{{t.aiNote}}{{r.name}} — {{r.flag}}</text></view>
              </block>
              <button class="otl-batch" hover-class="punch-cta-hd" data-i="{{index}}" bindtap="batchApproveTable">⚡ {{t.otlBatch}}</button>
              <view class="drill-hint">{{t.otlHint}}</view>
            </view>
          </view>

          <!-- ot_request:EE 提交加班申请表单(HITL:确认提交后才调工具) -->
          <view wx:elif="{{item.ctype === 'ot_request'}}" class="a2ui">
            <view class="a2-h"><image class="a2-img" src="/assets/icons/filetext-blue.svg" />{{t.otReqTitle}}<text class="a2-badge">A2UI · ot_request</text></view>
            <view class="a2-b">
              <!-- OT 类型:OT Pay / OT Leave 二选一 -->
              <view class="otf-label">{{t.kOtType}}</view>
              <view class="otf-seg">
                <view class="otf-opt {{item.otType === 'pay' ? 'otf-opt-on' : ''}} {{item.status !== 'pending' ? 'otf-opt-off' : ''}}"
                      data-i="{{index}}" data-v="pay" bindtap="otTypeTap">
                  <view class="otf-opt-t">{{t.otTypePay}}</view>
                  <view class="otf-opt-d">{{t.otTypePayDesc}}</view>
                </view>
                <view class="otf-opt {{item.otType === 'leave' ? 'otf-opt-on' : ''}} {{item.status !== 'pending' ? 'otf-opt-off' : ''}}"
                      data-i="{{index}}" data-v="leave" bindtap="otTypeTap">
                  <view class="otf-opt-t">{{t.otTypeLeave}}</view>
                  <view class="otf-opt-d">{{t.otTypeLeaveDesc}}</view>
                </view>
              </view>
              <!-- 日期 / 起止时间:原生 picker,时长自动计算 -->
              <picker mode="date" value="{{item.date}}" disabled="{{item.status !== 'pending'}}" data-i="{{index}}" bindchange="otDate">
                <view class="otf-row" hover-class="otf-row-hd"><text class="otf-k">{{t.kDate}}</text><text class="otf-v">{{item.date}}</text><text wx:if="{{item.status === 'pending'}}" class="otf-arrow">›</text></view>
              </picker>
              <picker mode="time" value="{{item.start}}" disabled="{{item.status !== 'pending'}}" data-i="{{index}}" bindchange="otStart">
                <view class="otf-row" hover-class="otf-row-hd"><text class="otf-k">{{t.kStart}}</text><text class="otf-v">{{item.start}}</text><text wx:if="{{item.status === 'pending'}}" class="otf-arrow">›</text></view>
              </picker>
              <picker mode="time" value="{{item.end}}" disabled="{{item.status !== 'pending'}}" data-i="{{index}}" bindchange="otEnd">
                <view class="otf-row" hover-class="otf-row-hd"><text class="otf-k">{{t.kEnd}}</text><text class="otf-v">{{item.end}}</text><text wx:if="{{item.status === 'pending'}}" class="otf-arrow">›</text></view>
              </picker>
              <view class="otf-row otf-row-static"><text class="otf-k">{{t.kDuration}}</text><text class="otf-v">{{item.durationText}}</text></view>
              <!-- 事由:选填,锁定后显示纯文本 -->
              <view class="otf-row">
                <text class="otf-k">{{t.kReason}}</text>
                <input wx:if="{{item.status === 'pending'}}" class="otf-inp" value="{{item.reason}}" placeholder="{{t.otReasonPh}}"
                       placeholder-class="otf-ph" data-i="{{index}}" bindinput="otReason" />
                <text wx:else class="otf-v">{{item.reason || '—'}}</text>
              </view>
              <!-- 动作区:唯一主 CTA + 文字按钮(同 clock_punch) -->
              <view wx:if="{{item.status === 'pending'}}" class="punch-actions">
                <button class="punch-cta" hover-class="punch-cta-hd" data-i="{{index}}" bindtap="submitOtReq">✓ {{t.otSubmit}}</button>
                <button class="punch-ghost" hover-class="punch-ghost-hd" data-i="{{index}}" bindtap="cancelOtReq">{{t.punchCancel}}</button>
              </view>
              <view wx:elif="{{item.status === 'done'}}" class="adone adone-ok">{{t.otSubmitted}}</view>
              <view wx:else class="adone adone-no">{{t.punchCancelled}}</view>
            </view>
          </view>

          <!-- anomaly_alert -->
          <view wx:elif="{{item.ctype === 'anomaly_alert'}}" class="a2ui">
            <view class="a2-h"><image class="a2-img" src="/assets/icons/alert-red.svg" />{{t.anomalyTitle}}<text class="a2-badge">A2UI · anomaly_alert</text></view>
            <view class="a2-b">
              <view wx:for="{{item.items}}" wx:for-item="a" wx:key="id" class="alert {{a.severity === 'high' ? 'alert-red' : 'alert-amber'}}">
                <view class="dot {{a.severity === 'high' ? 'dot-red' : 'dot-amber'}}"></view>
                <view class="c"><view class="t">{{a.title}}</view><view class="why">{{a.why}}<text class="ai">{{a.ai}}</text></view></view>
                <view class="sev {{a.severity === 'high' ? 'sev-high' : 'sev-mid'}}">{{a.severity === 'high' ? t.high : t.mid}}</view>
              </view>
            </view>
          </view>

          <!-- proactive -->
          <view wx:elif="{{item.ctype === 'proactive'}}" class="proact">
            <view class="proact-row"><image class="proact-img" src="/assets/icons/sparkles-blue.svg" /><view class="ptext">{{item.text}}</view></view>
            <view class="chips">
              <view wx:for="{{item.chips}}" wx:for-item="c" wx:for-index="ci" wx:key="label"
                    class="chip {{c.solid ? 'chip-solid' : ''}} {{item.done ? 'chip-off' : ''}}"
                    data-i="{{index}}" data-action="{{c.action}}" bindtap="chipTap">{{c.label}}</view>
            </view>
          </view>

          <!-- generated_dashboard -->
          <view wx:elif="{{item.ctype === 'generated_dashboard'}}" class="a2ui">
            <view class="a2-h"><image class="a2-img" src="/assets/icons/dashboard-blue.svg" />{{item.title}}{{t.aiGen}}<text class="a2-badge">A2UI · generated_dashboard</text></view>
            <view class="a2-b">
              <view class="gtiles">
                <view wx:for="{{item.tiles}}" wx:for-item="gt" wx:key="label" class="gtile">
                  <view class="gl">{{gt.label}}</view>
                  <view class="gv {{gt.danger ? 'danger' : ''}}">{{gt.value}}</view>
                </view>
              </view>
              <view class="mini-bars">
                <view wx:for="{{item.series}}" wx:for-item="v" wx:key="*this" class="mb" style="height: {{v}}%"></view>
              </view>
              <button class="pinbtn" size="mini" disabled="{{item.pinned}}" data-i="{{index}}" bindtap="pin">
                <image wx:if="{{!item.pinned}}" class="pin-img" src="/assets/icons/pin-white.svg" />{{item.pinned ? t.pinned : t.pinHome}}
              </button>
            </view>
          </view>

        </view>
      </block>
    </view>

    <view wx:if="{{streaming}}" class="row ai">
      <view class="av av-ai"><image class="av-ai-img" src="/assets/icons/sparkles-white.svg" /></view>
      <view class="typing"><view class="td"></view><view class="td"></view><view class="td"></view></view>
    </view>
    <view id="mbottom" style="height: 20rpx"></view>
  </scroll-view>

  <!-- recording overlay -->
  <view wx:if="{{recording}}" class="rec-overlay">
    <view class="rec-card {{cancelling ? 'rec-cancel' : ''}}">
      <view class="rec-mic">{{cancelling ? '✕' : '🎙'}}</view>
      <view wx:if="{{!cancelling}}" class="rec-wave">
        <view class="wv"></view><view class="wv"></view><view class="wv"></view><view class="wv"></view><view class="wv"></view>
      </view>
      <view class="rec-tip">{{cancelling ? t.recTipCancel : t.recTipUp}}</view>
    </view>
  </view>

  <!-- composer -->
  <view class="composer">
    <scroll-view class="sug" scroll-x>
      <view wx:for="{{suggestions}}" wx:key="*this" class="q" data-q="{{item}}" bindtap="onSuggest">{{item}}</view>
    </scroll-view>
    <view class="box">
      <view class="mic" bindtap="toggleVoiceMode">{{voiceMode ? '⌨️' : '🎤'}}</view>
      <view wx:if="{{voiceMode}}" class="talk {{recording ? (cancelling ? 'talk-cancel' : 'talk-on') : ''}}"
            bindtouchstart="recStart" bindtouchmove="recMove" bindtouchend="recEnd" bindtouchcancel="recEnd">
        {{recording ? (cancelling ? t.talkCancel : t.talkSend) : t.talkIdle}}
      </view>
      <block wx:else>
        <input class="inp" value="{{input}}" placeholder="{{t.inputPlaceholder}}" confirm-type="send"
               bindinput="onInput" bindconfirm="onSendTap" />
        <button class="send" size="mini" disabled="{{streaming || !input}}" bindtap="onSendTap">↑</button>
      </block>
    </view>
  </view>
</view>
