/* ============================================================
   Chat (AI 助手) — REDESIGN
   Navy + intelligence-blue, premium A2UI cards.
   Drop-in replacement for pages/chat/chat.wxss.
   ============================================================ */
.chat { display: flex; flex-direction: column; height: 100vh; overflow: hidden; }

/* ── in-page header ── */
.mini-head { flex-shrink: 0; display: flex; align-items: center; padding: 16rpx 24rpx; background: #fff; border-bottom: 1rpx solid var(--line); z-index: 10; }
.mh-right { display: flex; align-items: center; gap: 16rpx; flex-shrink: 0; }
.mh-left { display: flex; align-items: center; gap: 16rpx; flex: 1; min-width: 0; }
.mh-ava { width: 60rpx; height: 60rpx; border-radius: 16rpx; background: linear-gradient(135deg, #20307D, #2A63E6); color: #fff; text-align: center; line-height: 60rpx; font-size: 30rpx; flex-shrink: 0; }
.mh-title { font-size: 28rpx; font-weight: 600; color: var(--ink); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.mh-sub { font-size: 20rpx; color: var(--green); margin-top: 2rpx; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.me-ava-btn { width: 60rpx; height: 60rpx; padding: 0; margin: 0; background: transparent; border-radius: 50%; line-height: normal; flex-shrink: 0; }
.me-ava-btn::after { border: none; }
.me-ava-img { width: 60rpx; height: 60rpx; display: block; border-radius: 50%; }
.me-ava-ph { width: 60rpx; height: 60rpx; border-radius: 50%; background: linear-gradient(135deg, #E0E4EC, #B7BFCE); position: relative; overflow: hidden; }
.me-ava-ph::before { content: ""; position: absolute; left: 50%; top: 14rpx; width: 26rpx; height: 26rpx; border-radius: 50%; background: #fff; transform: translateX(-50%); }
.me-ava-ph::after { content: ""; position: absolute; left: 50%; bottom: -4rpx; width: 44rpx; height: 32rpx; border-radius: 24rpx 24rpx 0 0; background: #fff; transform: translateX(-50%); }

.stream { flex: 1; min-height: 0; padding: 24rpx; box-sizing: border-box; }

.row { display: flex; gap: 16rpx; margin-bottom: 28rpx; }
.row.me { flex-direction: row-reverse; }
.av { width: 60rpx; height: 60rpx; border-radius: 16rpx; flex-shrink: 0; text-align: center; line-height: 60rpx; font-size: 30rpx; }
.av-ai { background: linear-gradient(135deg, #20307D, #2A63E6); color: #fff; }
.av-u { background: linear-gradient(135deg, #E0E4EC, #B7BFCE); position: relative; overflow: hidden; }
.av-u::before { content: ""; position: absolute; left: 50%; top: 13rpx; width: 24rpx; height: 24rpx; border-radius: 50%; background: #fff; transform: translateX(-50%); }
.av-u::after { content: ""; position: absolute; left: 50%; bottom: -4rpx; width: 42rpx; height: 30rpx; border-radius: 22rpx 22rpx 0 0; background: #fff; transform: translateX(-50%); }
.bubble { max-width: 78%; }
.me-bubble { background: var(--navy); color: #fff; padding: 20rpx 24rpx; border-radius: 24rpx 24rpx 8rpx 24rpx; font-size: 28rpx; }
.ai-bubble { max-width: 86%; }
.txt { background: #fff; border: 1rpx solid var(--line); padding: 22rpx 24rpx; border-radius: 24rpx 24rpx 24rpx 8rpx; font-size: 28rpx; line-height: 1.6; color: var(--ink); }

/* 工具调用 = 过程状态行:人话化主文案 + 原始工具名小字(弱化,不像正式消息) */
.toolcall { display: inline-block; font-size: 23rpx; color: var(--slate); background: var(--sunken); padding: 12rpx 20rpx; border-radius: 12rpx; }
.tc-main { display: flex; align-items: center; gap: 10rpx; }
.tc-raw { font-size: 18rpx; color: var(--mute); font-family: "SF Mono", "Roboto Mono", monospace; margin-top: 4rpx; padding-left: 36rpx; word-break: break-all; }

.progress { background: #fff; border: 1rpx solid var(--line); border-radius: 20rpx; padding: 22rpx; font-size: 24rpx; }
.pbar { height: 12rpx; background: var(--blue-tint); border-radius: 999rpx; overflow: hidden; margin: 16rpx 0 10rpx; }
.pbar-i { height: 100%; width: 100%; background: linear-gradient(90deg, #20307D, #2A63E6); }
.pstep { color: var(--slate); font-size: 22rpx; }

/* ── A2UI card ── */
.a2ui { background: #fff; border: 1rpx solid var(--line); border-radius: 24rpx; overflow: hidden; box-shadow: 0 1rpx 2rpx rgba(20,28,46,.05); }
.a2-h { padding: 22rpx 24rpx; border-bottom: 1rpx solid var(--divider); font-size: 26rpx; font-weight: 600; color: var(--ink); display: flex; align-items: center; }
.a2-badge { margin-left: auto; font-size: 18rpx; color: var(--blue); background: var(--blue-tint); border: 1rpx solid var(--blue-tint-bd); padding: 4rpx 14rpx; border-radius: 999rpx; }
.a2-b { padding: 24rpx; }

/* ── ot_breakdown ── */
.hbar { display: flex; align-items: center; gap: 16rpx; font-size: 26rpx; padding: 10rpx 12rpx; border-radius: 12rpx; }
.hbar-open { background: var(--blue-tint); }
.hnm { width: 110rpx; color: var(--slate); }
.htk { flex: 1; height: 32rpx; background: #EDF0F6; border-radius: 8rpx; overflow: hidden; }
.htk-i { height: 100%; background: linear-gradient(90deg, #3D7BFF, #20307D); }
.hvv { width: 80rpx; text-align: right; font-weight: 700; font-size: 24rpx; color: var(--ink); font-variant-numeric: tabular-nums; }
.drill { background: var(--sunken); border: 1rpx dashed var(--royal-200); border-radius: 14rpx; padding: 16rpx 20rpx; margin: 6rpx 12rpx 14rpx; }
.drow { display: flex; justify-content: space-between; font-size: 23rpx; color: var(--slate); padding: 6rpx 0; }
.drow .dh { color: var(--ink); font-weight: 600; }
.drill-hint { margin-top: 10rpx; font-size: 22rpx; color: var(--blue); }

/* ── ot_approval ── */
.aline { display: flex; justify-content: space-between; font-size: 26rpx; padding: 8rpx 0; }
.al-k { color: var(--mute); }
.b { font-weight: 700; }
.aflag { background: var(--amber-surface); border: 1rpx solid var(--amber-bd); color: #B45309; font-size: 23rpx; padding: 16rpx 20rpx; border-radius: 14rpx; margin: 12rpx 0; line-height: 1.5; }
.abtns { display: flex; gap: 18rpx; margin-top: 10rpx; }
.bb { flex: 1; margin: 0; font-size: 26rpx; border-radius: 14rpx; font-weight: 600; }
.bb.ok { background: var(--green); color: #fff; }
.bb.no { background: #fff; color: var(--red); border: 1rpx solid var(--red-bd); }
.adone { text-align: center; font-size: 26rpx; font-weight: 600; padding: 18rpx; border-radius: 14rpx; }
.adone-ok { background: var(--green-surface); color: var(--green); }
.adone-no { background: var(--red-surface); color: var(--red); }

/* ── proactive ── */
.proact { background: linear-gradient(135deg, #F1F6FF, #EDF1FE); border: 1rpx solid var(--blue-tint-bd); border-radius: 24rpx; padding: 24rpx; }
.ptext { font-size: 26rpx; line-height: 1.6; color: var(--ink); }
.chips { display: flex; flex-wrap: wrap; gap: 14rpx; margin-top: 18rpx; }
.chip { font-size: 24rpx; background: #fff; border: 1rpx solid var(--royal-200); color: var(--navy); padding: 14rpx 22rpx; border-radius: 999rpx; font-weight: 600; }
.chip-solid { background: var(--navy); color: #fff; border-color: transparent; }
.chip-off { opacity: .5; }

/* ── generated dashboard ── */
.gtiles { display: grid; grid-template-columns: 1fr 1fr 1fr; gap: 14rpx; margin-bottom: 18rpx; }
.gtile { flex: 1; background: var(--sunken); border: none; border-radius: 16rpx; padding: 16rpx; }
.gl { font-size: 20rpx; color: var(--mute); }
.gv { font-size: 34rpx; font-weight: 800; margin-top: 4rpx; color: var(--ink); font-variant-numeric: tabular-nums; }
.gv.danger { color: var(--red); }
.mini-bars { display: flex; align-items: flex-end; gap: 12rpx; height: 120rpx; }
.mini-bars .mb { flex: 1; background: linear-gradient(#79A2FF, #20307D); border-radius: 6rpx 6rpx 1rpx 1rpx; }
.pinbtn { margin: 18rpx 0 0; width: 100%; background: var(--navy); color: #fff; font-size: 26rpx; border-radius: 14rpx; font-weight: 600; }
.pinbtn[disabled] { background: var(--royal-200); color: #fff; }

/* ── typing ── */
.typing { background: #fff; border: 1rpx solid var(--line); border-radius: 24rpx; padding: 26rpx 28rpx; display: flex; gap: 10rpx; }
.td { width: 14rpx; height: 14rpx; border-radius: 50%; background: #7E8CD2; }

/* ── composer ── */
.composer { background: var(--bg); padding: 16rpx 24rpx; padding-bottom: calc(16rpx + env(safe-area-inset-bottom)); border-top: 1rpx solid var(--line); }
.sug { white-space: nowrap; margin-bottom: 14rpx; }
.sug .q { display: inline-block; font-size: 22rpx; color: var(--slate); background: #fff; border: 1rpx solid var(--line); padding: 12rpx 20rpx; border-radius: 999rpx; margin-right: 12rpx; }
.box { background: #fff; border: 2rpx solid var(--royal-200); border-radius: 24rpx; padding: 10rpx 12rpx; display: flex; align-items: center; gap: 12rpx; }
.mic { width: 64rpx; height: 64rpx; line-height: 64rpx; text-align: center; font-size: 34rpx; background: var(--sunken); border-radius: 16rpx; flex-shrink: 0; }
.mic:active { background: #E0E4EC; }
.inp { flex: 1; font-size: 28rpx; }
.send { width: 72rpx; height: 72rpx; line-height: 72rpx; border-radius: 16rpx; background: var(--navy); color: #fff; font-size: 32rpx; margin: 0; padding: 0; }
.send[disabled] { background: var(--royal-200); color: #fff; }

/* ============================================================
   Icon images (replacing emoji) + new row wrappers
   ============================================================ */
.mh-ava { display: flex; align-items: center; justify-content: center; }
.mh-ava-img { width: 34rpx; height: 34rpx; }
.av-ai { display: flex; align-items: center; justify-content: center; }
.av-ai-img { width: 32rpx; height: 32rpx; }

.tc-img { width: 26rpx; height: 26rpx; flex-shrink: 0; }

.prog-head { display: flex; align-items: center; gap: 10rpx; color: var(--slate); }
.prog-img { width: 26rpx; height: 26rpx; flex-shrink: 0; }

.a2-img { width: 28rpx; height: 28rpx; margin-right: 10rpx; flex-shrink: 0; }

.aflag { display: flex; align-items: flex-start; gap: 10rpx; }
.aflag-img { width: 28rpx; height: 28rpx; flex-shrink: 0; margin-top: 2rpx; }

.proact-row { display: flex; align-items: flex-start; gap: 10rpx; }
.proact-img { width: 30rpx; height: 30rpx; flex-shrink: 0; margin-top: 2rpx; }
.proact .ptext { flex: 1; }

.pinbtn { display: flex; align-items: center; justify-content: center; gap: 10rpx; }
.pin-img { width: 28rpx; height: 28rpx; }

.mic { display: flex; align-items: center; justify-content: center; }
.mic-img { width: 36rpx; height: 36rpx; }
.mic-kbd { font-size: 36rpx; color: var(--slate); line-height: 1; }

/* ============================================================
   Voice mode — push-to-talk bar + recording overlay
   (on-brand styles for the existing voice UI in the WXML)
   ============================================================ */
.talk {
  flex: 1; height: 72rpx; border-radius: 16rpx;
  display: flex; align-items: center; justify-content: center;
  background: var(--sunken); color: var(--slate);
  font-size: 28rpx; font-weight: 600;
  border: 1rpx solid var(--royal-200);
}
.talk-on { background: var(--navy); color: #fff; border-color: transparent; }
.talk-cancel { background: var(--red-surface); color: var(--red); border-color: var(--red-bd); }

.rec-overlay {
  position: fixed; inset: 0; z-index: 100;
  display: flex; align-items: center; justify-content: center;
  background: rgba(14,22,41,.45);
}
.rec-card {
  width: 320rpx; padding: 44rpx 0 28rpx; border-radius: 28rpx;
  background: linear-gradient(135deg, #20307D, #2A63E6); color: #fff;
  display: flex; flex-direction: column; align-items: center; gap: 22rpx;
  box-shadow: 0 20rpx 60rpx rgba(14,22,41,.35);
}
.rec-cancel { background: linear-gradient(135deg, #C32B2B, #DC2626); }
.rec-mic { font-size: 64rpx; line-height: 1; }
.rec-wave { display: flex; align-items: flex-end; gap: 8rpx; height: 56rpx; }
.rec-wave .wv {
  width: 8rpx; border-radius: 999rpx; background: rgba(255,255,255,.85);
  animation: recWave .9s ease-in-out infinite;
}
.rec-wave .wv:nth-child(1) { height: 24rpx; animation-delay: 0s; }
.rec-wave .wv:nth-child(2) { height: 44rpx; animation-delay: .1s; }
.rec-wave .wv:nth-child(3) { height: 56rpx; animation-delay: .2s; }
.rec-wave .wv:nth-child(4) { height: 40rpx; animation-delay: .3s; }
.rec-wave .wv:nth-child(5) { height: 28rpx; animation-delay: .15s; }
@keyframes recWave { 0%, 100% { transform: scaleY(.5); } 50% { transform: scaleY(1); } }
.rec-tip { font-size: 24rpx; color: rgba(255,255,255,.85); }

/* language toggle (in header) */
.mh-meta { min-width: 0; }
.langbar { display: flex; flex-shrink: 0; margin: 0 14rpx; }
.langbar .seg { font-size: 20rpx; padding: 6rpx 14rpx; color: var(--slate); background: #fff; border: 1rpx solid var(--line); }
.langbar .seg:first-child { border-radius: 999rpx 0 0 999rpx; border-right: none; }
.langbar .seg:last-child { border-radius: 0 999rpx 999rpx 0; }
.langbar .seg.on { background: var(--navy); color: #fff; border-color: var(--navy); }

/* ---- clock_punch 打卡确认卡 ---- */
/* hero:深 navy 面板 + 右上装饰圆 */
.punch-hero { position: relative; overflow: hidden; background: linear-gradient(135deg, #232E6E 0%, #2A3A9C 100%); border-radius: 24rpx; padding: 28rpx 28rpx 30rpx; margin-bottom: 18rpx; }
.punch-hero::after { content: ""; position: absolute; right: -60rpx; top: -60rpx; width: 220rpx; height: 220rpx; border-radius: 50%; background: rgba(255,255,255,.06); }
.ph-top { display: flex; align-items: center; justify-content: space-between; margin-bottom: 14rpx; }
.ph-type { display: flex; align-items: center; gap: 10rpx; font-size: 21rpx; font-weight: 700; letter-spacing: 2rpx; color: rgba(255,255,255,.85); text-transform: uppercase; }
.ph-dot { width: 14rpx; height: 14rpx; border-radius: 50%; background: #4ADE80; }
.ph-badge { font-size: 21rpx; color: #fff; background: rgba(255,255,255,.14); border: 1rpx solid rgba(255,255,255,.3); padding: 6rpx 20rpx; border-radius: 999rpx; }
.ph-badge-warn { background: rgba(245,158,11,.25); border-color: rgba(245,158,11,.5); }
.ph-time { font-size: 96rpx; font-weight: 800; color: #fff; line-height: 1.05; font-variant-numeric: tabular-nums; letter-spacing: 2rpx; }
.ph-sec { font-size: 44rpx; font-weight: 700; color: rgba(255,255,255,.45); }
.ph-date { font-size: 23rpx; color: rgba(255,255,255,.72); margin-top: 10rpx; line-height: 1.5; }

/* 地点卡:图标章 + 名称 + 围栏状态副行 */
.ploc { display: flex; align-items: center; gap: 18rpx; border: 1rpx solid var(--line); border-radius: 20rpx; padding: 22rpx 22rpx; }
.ploc-hd { background: var(--sunken); }
.ploc-ic { width: 64rpx; height: 64rpx; border-radius: 16rpx; background: var(--blue-tint); display: flex; align-items: center; justify-content: center; flex-shrink: 0; }
.ploc-img { width: 32rpx; height: 32rpx; }
.ploc-c { flex: 1; min-width: 0; }
.ploc-name { font-size: 27rpx; font-weight: 700; color: var(--ink); }
.ploc-sub { font-size: 21rpx; margin-top: 4rpx; }
.ploc-sub.pending { color: var(--mute); }
.ploc-sub.ok { color: var(--green); font-weight: 600; }
.ploc-sub.fail { color: var(--red); }
.prow-arrow { color: var(--mute); font-size: 30rpx; line-height: 1; flex-shrink: 0; }

/* 动作区:唯一主 CTA(圆角矩形)+ 次级文字按钮 */
.punch-actions { margin-top: 22rpx; }
.punch-cta { width: 100%; height: 92rpx; line-height: 92rpx; border-radius: 22rpx; background: #25337F; color: #fff; font-size: 30rpx; font-weight: 700; letter-spacing: 1rpx; box-shadow: 0 8rpx 20rpx rgba(32,48,125,.25); padding: 0; }
.punch-cta::after { border: none; }
.punch-cta-hd { opacity: .88; box-shadow: 0 4rpx 10rpx rgba(32,48,125,.18); }
.punch-ghost { width: 100%; height: 72rpx; line-height: 72rpx; margin-top: 8rpx; background: transparent; color: var(--mute); font-size: 26rpx; font-weight: 500; padding: 0; border-radius: 16rpx; }
.punch-ghost::after { border: none; }
.punch-ghost-hd { background: var(--sunken); color: var(--slate); }

/* 清空对话(header 右侧小按钮) */
.mh-clear { height: 56rpx; line-height: 54rpx; box-sizing: border-box; font-size: 22rpx; color: var(--slate); background: #fff; border: 1rpx solid var(--line); border-radius: 999rpx; padding: 0 24rpx; }
.mh-clear-hd { background: var(--sunken); }
