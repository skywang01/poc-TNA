.page { padding: 24rpx 24rpx 140rpx; }

/* AI summary band */
.summary {
  border-radius: 28rpx; padding: 28rpx;
  background: linear-gradient(115deg, #eef2ff, #faf5ff 60%, #fff7ed);
  border: 1rpx solid #e9d5ff;
  display: flex; gap: 22rpx; margin-bottom: 24rpx;
}
.summary .spark {
  width: 64rpx; height: 64rpx; border-radius: 18rpx; flex-shrink: 0;
  background: linear-gradient(135deg, #7c3aed, #4f46e5);
  color: #fff; font-size: 34rpx;
  display: flex; align-items: center; justify-content: center;
}
.stxt { flex: 1; }
.tag { font-size: 20rpx; color: #7c3aed; background: #fff; border: 1rpx solid #e9d5ff; padding: 2rpx 14rpx; border-radius: 10rpx; display: inline-block; margin-bottom: 12rpx; }
.sline { font-size: 26rpx; line-height: 1.7; color: #3b3654; }
.sline .b { color: #4f46e5; font-weight: 600; }
.sline .up { color: #16a34a; }
.sline .risk { color: #dc2626; font-weight: 600; }
.sactions { display: flex; gap: 16rpx; margin-top: 18rpx; }
.sactions .btn { margin: 0; }

/* pinned */
.pinned-wrap { margin-bottom: 8rpx; }
.pinned-head { font-size: 22rpx; color: #94a3b8; margin-bottom: 12rpx; }
.pinned-card { border-color: #ddd6fe; position: relative; }
.unpin { position: absolute; top: 18rpx; right: 18rpx; width: 44rpx; height: 44rpx; border-radius: 12rpx; background: #f1f5f9; color: #64748b; text-align: center; line-height: 44rpx; font-size: 24rpx; }
.pinned-title { font-size: 26rpx; color: #7c3aed; font-weight: 600; margin-bottom: 18rpx; }

/* KPI */
.kpis { display: flex; flex-wrap: wrap; gap: 18rpx; margin-bottom: 8rpx; }
.kpi { width: calc(50% - 9rpx); background: #fff; border: 1rpx solid #e9edf3; border-radius: 24rpx; padding: 24rpx; box-sizing: border-box; }
.kl { font-size: 22rpx; color: #94a3b8; }
.kv { font-size: 44rpx; font-weight: 800; margin-top: 8rpx; }
.kd { font-size: 22rpx; margin-top: 4rpx; }
.up { color: #16a34a; }
.down { color: #dc2626; }

/* bars */
.bars { display: flex; align-items: flex-end; height: 260rpx; gap: 24rpx; padding-top: 10rpx; }
.bar-col { flex: 1; display: flex; flex-direction: column; align-items: center; justify-content: flex-end; }
.bar { width: 100%; background: linear-gradient(#818cf8, #4f46e5); border-radius: 10rpx 10rpx 0 0; }
.bar-label { font-size: 22rpx; color: #94a3b8; margin-top: 12rpx; }

.spark-bars { display: flex; align-items: flex-end; gap: 16rpx; height: 140rpx; }
.sb { flex: 1; background: linear-gradient(#a5b4fc, #4f46e5); border-radius: 8rpx 8rpx 0 0; }

/* generated mini dashboard tiles */
.gtiles { display: flex; gap: 14rpx; margin-bottom: 18rpx; }
.gtile { flex: 1; background: #f8fafc; border: 1rpx solid #eef2f7; border-radius: 16rpx; padding: 16rpx; }
.gl { font-size: 20rpx; color: #94a3b8; }
.gv { font-size: 34rpx; font-weight: 800; margin-top: 4rpx; }
.gv.danger { color: #dc2626; }
.mini-bars { display: flex; align-items: flex-end; gap: 12rpx; height: 100rpx; }
.mini-bars .mb { flex: 1; background: linear-gradient(#a5b4fc, #4f46e5); border-radius: 6rpx 6rpx 0 0; }

/* FAB */
.fab {
  position: fixed; right: 40rpx; bottom: 130rpx;
  width: 100rpx; height: 100rpx; border-radius: 32rpx;
  background: linear-gradient(135deg, #7c3aed, #4f46e5); color: #fff;
  font-size: 44rpx; text-align: center; line-height: 100rpx;
  box-shadow: 0 12rpx 36rpx rgba(79,70,229,.4);
}
