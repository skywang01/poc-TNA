/* ============================================================
   Dashboard (AI 看板) — REDESIGN
   The AI summary band becomes a premium dark-navy gradient.
   Drop-in replacement for pages/dashboard/dashboard.wxss.
   ============================================================ */
.page { padding: 24rpx 24rpx 140rpx; }

/* ── AI summary band — premium dark navy ── */
.summary {
  position: relative; overflow: hidden;
  border-radius: 32rpx; padding: 30rpx;
  background: linear-gradient(135deg, #20307D 0%, #131C4D 70%, #0E1640 100%);
  border: none; color: #fff;
  display: flex; gap: 22rpx; margin-bottom: 24rpx;
  box-shadow: 0 8rpx 24rpx rgba(20,28,46,.16);
}
.summary .spark {
  width: 64rpx; height: 64rpx; border-radius: 16rpx; flex-shrink: 0;
  background: rgba(255,255,255,.16);
  border: 1rpx solid rgba(255,255,255,.28);
  color: #fff; font-size: 34rpx;
  display: flex; align-items: center; justify-content: center;
}
.stxt { flex: 1; }
.tag {
  font-size: 20rpx; letter-spacing: 1.2rpx; text-transform: uppercase;
  color: rgba(255,255,255,.82);
  background: rgba(255,255,255,.12);
  border: 1rpx solid rgba(255,255,255,.22);
  padding: 4rpx 14rpx; border-radius: 999rpx; display: inline-block; margin-bottom: 12rpx;
}
.sline { font-size: 26rpx; line-height: 1.7; color: rgba(255,255,255,.9); }
.sline .b { color: #fff; font-weight: 600; }
.sline .up { color: #7EE0A8; font-weight: 600; }
.sline .risk { color: #FFB4AB; font-weight: 600; }
.sactions { display: flex; gap: 16rpx; margin-top: 18rpx; }
.sactions .btn { margin: 0; }
/* recolor the band's buttons so they read on dark navy */
.summary .btn-primary { background: #fff; color: #20307D; }
.summary .btn-ghost { background: rgba(255,255,255,.12); color: #fff; border: 1rpx solid rgba(255,255,255,.32); }

/* ── pinned ── */
.pinned-wrap { margin-bottom: 8rpx; }
.pinned-head { font-size: 22rpx; color: var(--mute); margin-bottom: 12rpx; }
.pinned-card { border-color: var(--blue-tint-bd); position: relative; }
.unpin { position: absolute; top: 18rpx; right: 18rpx; width: 44rpx; height: 44rpx; border-radius: 12rpx; background: var(--sunken); color: var(--slate); text-align: center; line-height: 44rpx; font-size: 24rpx; }
.pinned-title { font-size: 26rpx; color: var(--blue); font-weight: 600; margin-bottom: 18rpx; }

/* ── KPI grid ── */
.kpis { display: grid; grid-template-columns: 1fr 1fr; gap: 18rpx; margin-bottom: 8rpx; }
.kpi { background: #fff; border: 1rpx solid var(--line); border-radius: 28rpx; padding: 24rpx; box-sizing: border-box; display: flex; flex-direction: column; box-shadow: 0 1rpx 2rpx rgba(20,28,46,.05); }
.kl { font-size: 20rpx; letter-spacing: 1rpx; text-transform: uppercase; color: var(--mute); font-weight: 600; }
.kv { font-size: 44rpx; font-weight: 800; margin-top: 8rpx; line-height: 1.1; color: var(--ink); font-variant-numeric: tabular-nums; }
.kd { font-size: 22rpx; margin-top: 6rpx; font-variant-numeric: tabular-nums; }
.up { color: var(--green); }
.down { color: var(--red); }

/* ── bars (OT by dept) ── */
.bars { display: flex; align-items: flex-end; height: 260rpx; gap: 24rpx; padding-top: 10rpx; }
.bar-col { flex: 1; display: flex; flex-direction: column; align-items: center; justify-content: flex-end; }
.bar { width: 100%; max-width: 92rpx; background: linear-gradient(#4356B2, #20307D); border-radius: 12rpx 12rpx 4rpx 4rpx; }
.bar-label { font-size: 22rpx; color: var(--mute); margin-top: 12rpx; }

.spark-bars { display: flex; align-items: flex-end; gap: 16rpx; height: 140rpx; }
.sb { flex: 1; background: linear-gradient(#79A2FF, #20307D); border-radius: 8rpx 8rpx 2rpx 2rpx; }

/* ── generated mini dashboard tiles ── */
.gtiles { display: grid; grid-template-columns: 1fr 1fr 1fr; gap: 14rpx; margin-bottom: 18rpx; }
.gtile { flex: 1; background: var(--sunken); border: none; border-radius: 16rpx; padding: 16rpx; }
.gl { font-size: 20rpx; color: var(--mute); }
.gv { font-size: 34rpx; font-weight: 800; margin-top: 4rpx; color: var(--ink); font-variant-numeric: tabular-nums; }
.gv.danger { color: var(--red); }
.mini-bars { display: flex; align-items: flex-end; gap: 12rpx; height: 100rpx; }
.mini-bars .mb { flex: 1; background: linear-gradient(#79A2FF, #20307D); border-radius: 6rpx 6rpx 1rpx 1rpx; }

/* ── icon images (replace emoji) ── */
.spark { display: flex; align-items: center; justify-content: center; }
.spark-img { width: 34rpx; height: 34rpx; }
.card-title .ic .cic { width: 26rpx; height: 26rpx; }
.pinned-head { display: flex; align-items: center; gap: 8rpx; }
.pinned-head-img { width: 24rpx; height: 24rpx; }
.unpin { display: flex; align-items: center; justify-content: center; }
.unpin-img { width: 22rpx; height: 22rpx; }

/* ── FAB — pill with icon + label ── */
.fab {
  position: fixed; right: 32rpx; bottom: 130rpx;
  height: 92rpx; padding: 0 32rpx; border-radius: 999rpx;
  display: flex; align-items: center; gap: 12rpx;
  background: linear-gradient(135deg, #20307D, #2A63E6);
  box-shadow: 0 12rpx 36rpx rgba(42,99,230,.36);
}
.fab-img { width: 34rpx; height: 34rpx; }
.fab-label { color: #fff; font-size: 28rpx; font-weight: 600; line-height: 1; }

/* language toggle */
.langbar { display: flex; justify-content: flex-end; margin-bottom: 8rpx; }
.langbar .seg { font-size: 20rpx; padding: 8rpx 18rpx; color: var(--slate); background: #fff; border: 1rpx solid var(--line); }
.langbar .seg:first-child { border-radius: 999rpx 0 0 999rpx; border-right: none; }
.langbar .seg:last-child { border-radius: 0 999rpx 999rpx 0; }
.langbar .seg.on { background: var(--navy); color: #fff; border-color: var(--navy); }
