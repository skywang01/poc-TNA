/* ============================================================
   Dashboard (AI 看板) — NEW DESIGN SYSTEM
   Drop-in replacement for pages/dashboard/dashboard.wxss.
   ============================================================ */
.page { padding: 24rpx 24rpx 140rpx; }

/* ── AI summary band — premium dark navy hero ── */
.summary {
  position: relative; overflow: hidden;
  border-radius: 40rpx; padding: 32rpx;
  background: linear-gradient(152deg, #25337F 0%, #161E47 58%, #0C1230 100%);
  border: none; color: #fff;
  display: flex; gap: 22rpx; margin-bottom: 24rpx;
  box-shadow: 0 16rpx 40rpx rgba(16,22,56,.20);
}
.summary::after {
  content: ""; position: absolute; right: -60rpx; top: -70rpx;
  width: 280rpx; height: 280rpx; border-radius: 50%; background: rgba(255,255,255,.06);
}
.summary .spark {
  position: relative; z-index: 1;
  width: 64rpx; height: 64rpx; border-radius: 18rpx; flex-shrink: 0;
  background: linear-gradient(135deg, #3056F5, #7C5CFC);
  color: #fff; font-size: 34rpx;
  display: flex; align-items: center; justify-content: center;
  box-shadow: 0 8rpx 22rpx rgba(86,80,230,.4);
}
.stxt { flex: 1; position: relative; z-index: 1; }
.tag {
  font-size: 20rpx; letter-spacing: 1.4rpx; text-transform: uppercase;
  color: rgba(255,255,255,.82);
  background: rgba(255,255,255,.12);
  border: 1rpx solid rgba(255,255,255,.22);
  padding: 5rpx 16rpx; border-radius: 999rpx; display: inline-block; margin-bottom: 12rpx;
}
.sline { font-size: 26rpx; line-height: 1.7; color: rgba(255,255,255,.9); }
.sline .b { color: #fff; font-weight: 600; }
.sline .up { color: #7EE0A8; font-weight: 600; }
.sline .risk { color: #FFB4AB; font-weight: 600; }
.sactions { display: flex; flex-wrap: wrap; gap: 14rpx; margin-top: 18rpx; }
.sactions .btn { margin: 0; white-space: nowrap; font-size: 24rpx; padding: 14rpx 22rpx; line-height: 1.2; }
/* band buttons read on dark navy */
.summary .btn-primary { background: #fff; color: #20307D; box-shadow: none; }
.summary .btn-ghost { background: rgba(255,255,255,.12); color: #fff; border: 1rpx solid rgba(255,255,255,.32); }

/* ── pinned ── */
.pinned-wrap { margin-bottom: 8rpx; }
.pinned-head { font-size: 22rpx; color: var(--mute); margin-bottom: 12rpx; }
.pinned-card { border-color: var(--blue-tint-bd); position: relative; }
.unpin { position: absolute; top: 18rpx; right: 18rpx; width: 44rpx; height: 44rpx; border-radius: 12rpx; background: var(--sunken); color: var(--slate); text-align: center; line-height: 44rpx; font-size: 24rpx; }
.pinned-title { font-size: 26rpx; color: var(--blue); font-weight: 700; margin-bottom: 18rpx; }

/* ── KPI grid ── */
.kpis { display: grid; grid-template-columns: 1fr 1fr; gap: 18rpx; margin-bottom: 8rpx; }
.kpi { background: #fff; border: 1rpx solid var(--line); border-radius: 28rpx; padding: 24rpx; box-sizing: border-box; display: flex; flex-direction: column; box-shadow: 0 6rpx 18rpx rgba(20,28,70,.05); }
.kl { font-size: 20rpx; letter-spacing: 1rpx; text-transform: uppercase; color: var(--mute); font-weight: 700; }
.kv { font-size: 44rpx; font-weight: 800; margin-top: 8rpx; line-height: 1.1; color: var(--ink); font-variant-numeric: tabular-nums; }
.kd { font-size: 22rpx; margin-top: 6rpx; font-variant-numeric: tabular-nums; font-weight: 600; }
.up { color: var(--green); }
.down { color: var(--red); }

/* ── bars (OT by dept) ── */
.bars { display: flex; align-items: flex-end; height: 260rpx; gap: 24rpx; padding-top: 10rpx; }
.bar-col { flex: 1; display: flex; flex-direction: column; align-items: center; justify-content: flex-end; }
.bar { width: 100%; max-width: 92rpx; background: linear-gradient(180deg, #4A63E8, #1E2A63); border-radius: 14rpx 14rpx 4rpx 4rpx; }
.bar-label { font-size: 22rpx; color: var(--mute); margin-top: 12rpx; font-weight: 600; }

.spark-bars { display: flex; align-items: flex-end; gap: 16rpx; height: 140rpx; }
.sb { flex: 1; background: linear-gradient(180deg, #5B7BFF, #2545D8); border-radius: 10rpx 10rpx 2rpx 2rpx; }

/* ── generated mini dashboard tiles ── */
.gtiles { display: grid; grid-template-columns: 1fr 1fr 1fr; gap: 14rpx; margin-bottom: 18rpx; }
.gtile { flex: 1; background: var(--sunken); border: none; border-radius: 16rpx; padding: 16rpx; }
.gl { font-size: 20rpx; color: var(--mute); }
.gv { font-size: 34rpx; font-weight: 800; margin-top: 4rpx; color: var(--ink); font-variant-numeric: tabular-nums; }
.gv.danger { color: var(--red); }
.mini-bars { display: flex; align-items: flex-end; gap: 12rpx; height: 100rpx; }
.mini-bars .mb { flex: 1; background: linear-gradient(180deg, #5B7BFF, #2545D8); border-radius: 6rpx 6rpx 1rpx 1rpx; }

/* ── icon images (replace emoji) ── */
.spark { display: flex; align-items: center; justify-content: center; }
.spark-img { width: 34rpx; height: 34rpx; }
.card-title .ic .cic { width: 26rpx; height: 26rpx; }
.pinned-head { display: flex; align-items: center; gap: 8rpx; }
.pinned-head-img { width: 24rpx; height: 24rpx; }
.unpin { display: flex; align-items: center; justify-content: center; }
.unpin-img { width: 22rpx; height: 22rpx; }

/* ── FAB — gradient pill with icon + label ── */
.fab {
  position: fixed; right: 32rpx; bottom: 130rpx;
  height: 96rpx; padding: 0 34rpx; border-radius: 999rpx;
  display: flex; align-items: center; gap: 12rpx;
  background: linear-gradient(135deg, #3056F5, #7C5CFC);
  box-shadow: 0 14rpx 36rpx rgba(86,80,230,.42);
}
.fab-img { width: 34rpx; height: 34rpx; }
.fab-label { color: #fff; font-size: 28rpx; font-weight: 700; line-height: 1; white-space: nowrap; }

/* top bar: role chip + language toggle */
.topbar { display: flex; align-items: center; justify-content: space-between; margin-bottom: 8rpx; }
.rolechip { display: flex; align-items: center; gap: 10rpx; padding: 8rpx 18rpx; background: #fff; border: 1rpx solid var(--line); border-radius: 999rpx; font-size: 22rpx; color: var(--navy); font-weight: 700; }
.rolechip .role-dot { width: 14rpx; height: 14rpx; border-radius: 50%; }
.rolechip .role-dot.ee { background: var(--blue); }
.rolechip .role-dot.mgr { background: var(--navy); }
.rolechip .role-swap { color: var(--slate); font-size: 24rpx; }

/* first-screen role guide */
.role-mask { position: fixed; left: 0; right: 0; top: 0; bottom: 0; background: rgba(11,15,31,.55); display: flex; align-items: center; justify-content: center; z-index: 100; }
.role-card { width: 600rpx; background: #fff; border-radius: 36rpx; padding: 48rpx 40rpx; box-shadow: 0 28rpx 70rpx rgba(12,18,48,.34); }
.role-spark { width: 96rpx; height: 96rpx; border-radius: 26rpx; background: linear-gradient(135deg, #3056F5, #7C5CFC); display: flex; align-items: center; justify-content: center; margin: 0 auto 24rpx; box-shadow: 0 12rpx 30rpx rgba(86,80,230,.4); }
.role-spark-img { width: 48rpx; height: 48rpx; }
.role-title { font-size: 40rpx; font-weight: 800; color: var(--ink); text-align: center; letter-spacing: -0.5rpx; }
.role-sub { font-size: 24rpx; color: var(--slate); text-align: center; margin: 12rpx 0 32rpx; line-height: 1.5; }
.role-opts { display: flex; flex-direction: column; gap: 20rpx; }
.role-opt { display: flex; align-items: center; gap: 20rpx; padding: 28rpx 24rpx; border: 1rpx solid var(--line); border-radius: 24rpx; background: #fff; }
.role-opt:active { background: var(--blue-tint); border-color: var(--blue-tint-bd); }
.role-emoji { font-size: 48rpx; }
.role-meta { flex: 1; }
.role-opt-name { font-size: 30rpx; font-weight: 700; color: var(--ink); }
.role-opt-desc { font-size: 22rpx; color: var(--slate); margin-top: 4rpx; }
.role-arrow { color: var(--navy); font-size: 32rpx; font-weight: 700; }

/* language toggle */
.langbar { display: flex; justify-content: flex-end; margin-bottom: 8rpx; }
.langbar .seg { font-size: 20rpx; padding: 8rpx 18rpx; color: var(--slate); background: #fff; border: 1rpx solid var(--line); }
.langbar .seg:first-child { border-radius: 999rpx 0 0 999rpx; border-right: none; }
.langbar .seg:last-child { border-radius: 0 999rpx 999rpx 0; }
.langbar .seg.on { background: var(--navy); color: #fff; border-color: var(--navy); }

/* ---- AI Board groups ---- */
.ghead { display: flex; align-items: center; justify-content: space-between; margin: 28rpx 4rpx 14rpx; font-size: 28rpx; font-weight: 800; color: var(--ink); letter-spacing: -0.3rpx; }
.ghead-ask { font-size: 22rpx; font-weight: 600; color: var(--blue); }

/* 待办行 */
.todo { display: flex; align-items: center; gap: 18rpx; padding: 20rpx 4rpx; border-top: 1rpx solid var(--divider); }
.todo:first-of-type { border-top: none; }
.todo-c { flex: 1; min-width: 0; }
.todo-t { font-size: 26rpx; font-weight: 700; color: var(--ink); }
.todo-d { font-size: 22rpx; color: var(--slate); margin-top: 4rpx; }
.todo-btn { flex-shrink: 0; margin: 0; padding: 0 26rpx; height: 56rpx; line-height: 56rpx; font-size: 23rpx; font-weight: 700; color: #fff; background: var(--blue); border-radius: 999rpx; box-shadow: 0 4rpx 12rpx rgba(48,86,245,.24); }
.todo-btn::after { border: none; }
.todo-btn-hd { opacity: .85; }
