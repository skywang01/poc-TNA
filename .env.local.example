# ── Real Agent platform hookup ────────────────────────────────────────────
# Fill these in to talk to the real bipo-ai-service. This file is gitignored.

# 1. Vite proxy target — the real service base URL (server-side only, NOT
#    exposed to the browser). e.g. https://your-dev-host  or  http://localhost:8000
BIPO_TARGET=https://REPLACE_WITH_SERVICE_URL

# 2. Bearer token — injected by the Vite proxy into the Authorization header
#    (server-side only, never reaches the browser bundle).
BIPO_TOKEN=REPLACE_WITH_JWT

# 3. Frontend engine: "mock" (scripted demo) | "real" (call bipo-ai-service)
VITE_AGENT_MODE=mock

# 4. Which agent to invoke. payroll-assistant is a placeholder until the
#    Attendance agent is created — swap it then.
VITE_BIPO_AGENT_ID=payroll-assistant
