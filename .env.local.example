# ── Real Agent platform hookup (Service Key mode) ─────────────────────────
# Copy to .env.local (gitignored) and fill in BIPO_SERVICE_KEY to go live.

# 1. Vite proxy target — the real service base URL (server-side only).
BIPO_TARGET=https://bipo-ai-test.bipocloud.com

# 2. Service Key (machine-to-machine). Injected by the Vite proxy into the
#    x-service-key header (server-side only, never reaches the browser).
#    Create under Admin UI > Management > Service Keys.
BIPO_SERVICE_KEY=sk_xxx

# (Alternative) IDP Bearer token — used only if BIPO_SERVICE_KEY is empty.
# BIPO_TOKEN=

# 3. Frontend engine: "mock" (scripted demo) | "real" (call bipo-ai-service)
VITE_AGENT_MODE=real

# 4. Which agent to invoke.
VITE_BIPO_AGENT_ID=attendance-ai
